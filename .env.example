SECRET_KEY=change-me-to-a-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_PATH=/app/data/db.sqlite3
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@controlcenter.local
LOAD_SAMPLE_DATA=true
ANTHROPIC_API_KEY=
# Production only — enable HTTPS hardening. Turns on SSL redirect, HSTS,
# and Secure flags on the session + CSRF cookies. Set true when served
# over TLS (behind the Caddy proxy). Leave false/unset for local dev.
#ENABLE_SSL=true
# Production only — serve behind the Caddy proxy (no published port,
# external caddy-net). See docker-compose.prod.yml. Leave unset for dev.
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
